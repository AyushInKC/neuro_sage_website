PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/neurosage
CLIENT_URL=http://localhost:3000
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# AI provider — uses a locally-running Ollama server.
# See https://ollama.com for installation instructions.
# Production: replace OLLAMA_BASE_URL with your secured inference server URL.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
